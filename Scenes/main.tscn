	//float d_down = texture(DEPTH_TEXTURE, uv + vec2(0.0, -e.y)).r;
	//float d_left = texture(DEPTH_TEXTURE, uv + vec2(-e.x, 0.0)).r;
	//float d_right = texture(DEPTH_TEXTURE, uv + vec2(e.x, 0.0)).r;
//
