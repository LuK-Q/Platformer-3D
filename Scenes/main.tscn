	//vec3 n_down = texture(NORMAL_TEXTURE, uv + vec2(0.0, -e.y)).rgb * 2.0 - 1.0;
	//vec3 n_left = texture(NORMAL_TEXTURE, uv + vec2(-e.x, 0.0)).rgb * 2.0 - 1.0;
	//vec3 n_right = texture(NORMAL_TEXTURE, uv + vec2(e.x, 0.0)).rgb * 2.0 - 1.0;
